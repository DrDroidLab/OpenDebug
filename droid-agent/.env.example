# ── Provider selection ──
# Options: openai, claude, azure-openai, azure-kimi
AI_PROVIDER=azure-openai

# ── Direct OpenAI ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1

# ── Anthropic Claude ──
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Azure AI Foundry — OpenAI models ──
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=openai-5.2
AZURE_API_VERSION=2025-04-01-preview

# ── Azure AI Foundry — Kimi models ──
# AZURE_KIMI_ENDPOINT=https://your-resource.services.ai.azure.com
# AZURE_KIMI_API_KEY=your-api-key-here
# AZURE_KIMI_DEPLOYMENT=kimi-k2

# ── General ──
AGENT_NAME=Droid Agent
PORT=7433

# Redis (internal — no need to change)
REDIS_URL=redis://redis:6379

# PostgreSQL (internal — no need to change)
DATABASE_URL=postgresql://droidagent:droidagent@postgres:5432/droidagent
